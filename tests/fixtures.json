    {"name": "v6_in_path", "template": "http://example.com/ip/{A}/check", "values": {"A": ["2001:db8::5"]}, "expect": ["http://example.com/ip/2001:db8::5/check"]},
    {"name": "bracketed_value_in_query", "template": "http://127.0.0.1/which?addr={A}", "values": {"A": ["[::1]"]}, "expect": ["http://127.0.0.1/which?addr=::1"]},
    {"name": "no_scheme", "template": "{A}:8080/which", "values": {"A": ["::1"]}, "expect": ["[::1]:8080/which"]},
    {"name": "padded_number_in_path", "template": "http://example.com/live/{N}_1.m3u8", "values": {"N": ["0001", "0099", "9999"]}, "expect": ["http://example.com/live/0001_1.m3u8", "http://example.com/live/0099_1.m3u8", "http://example.com/live/9999_1.m3u8"]},
    {"name": "multi_variable_cartesian", "template": "http://{A}:{P}/which?peer={B}", "values": {"A": ["127.0.0.1", "::1"], "P": ["8000"], "B": ["x", "y"]}, "expect": ["http://127.0.0.1:8000/which?peer=x", "http://127.0.0.1:8000/which?peer=y", "http://[::1]:8000/which?peer=x", "http://[::1]:8000/which?peer=y"]}
  ]
